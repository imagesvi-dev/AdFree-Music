                    <span class="trending-item__num" aria-hidden="true">@(i + 1)</span>
                    <div class="trending-item__art">
                        <img src="@song.ImageUrl" alt="@song.Name" loading="lazy" onerror="this.src=artFallback()"/>
                    </div>
                    <div class="trending-item__info">
                        <div class="trending-item__name">@song.Name</div>
                        <div class="trending-item__artist">@song.ArtistName</div>
                    </div>
                    <span class="trending-item__dur">@song.DurationFormatted</span>
                </article>
            }
        </div>
    </section>

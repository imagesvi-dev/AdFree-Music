<!-- ─── Featured Albums ─── -->
@if (Model.FeaturedAlbums.Any())
{
    <section class="section" aria-labelledby="albums-title">
        <div class="section-header">
            <h2 class="section-title" id="albums-title">💿 Popular Albums</h2>
            <a class="section-link" href="/SeeAll?type=albums">See All →</a>
        </div>
        <div class="scroll-row">
            @foreach (var album in Model.FeaturedAlbums.Take(12))
            {
                <article class="album-card" tabindex="0" role="button"
                         aria-label="Browse @album.Name by @album.ArtistName"
                         onclick="window.location.href='/Album/@album.Id'"
                         onkeydown="if(event.key==='Enter') window.location.href='/Album/@album.Id'">
                    <div class="album-card__art">
                        <img src="@album.ImageUrl" alt="@album.Name" loading="lazy" onerror="this.src=artFallback()"/>
                        <div class="album-card__overlay">
                            <div class="album-card__play-btn" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                            </div>
                        </div>
                    </div>
                    <div class="album-card__meta">
                        <div class="album-card__title">@album.Name</div>
                        <div class="album-card__artist">@album.ArtistName</div>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (!Model.AllSongs.Any())
{
    <div class="empty-state" aria-live="polite">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
        </svg>
        <p class="empty-state__title">Loading music…</p>
        <p class="empty-state__sub">Use the search bar above to find your favourite songs and artists.</p>
    </div>
}

@section Scripts {
    <script>
        // Build the full queue from all songs for playback
        const allSongs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.AllSongs.Select(s => new {
                id               = s.Id,
                name             = s.Name,
                artist           = s.ArtistName,
                album            = s.AlbumName,
                image            = s.ImageUrl,
                streamUrl        = $"/api/stream/{s.Id}",
                duration         = s.DurationSeconds,
                durationFormatted= s.DurationFormatted
            })
        ));

        window.setQueue?.(allSongs);

        function playSong(songId) {
            const idx = allSongs.findIndex(s => s.id === songId);
            if (idx >= 0) {
                window.playTrack?.(allSongs[idx], allSongs, idx);
                // Highlight all cards with this id
                document.querySelectorAll('[data-song-id]').forEach(el =>
                    el.classList.toggle('is-active', el.dataset.songId === songId));
            }
        }

        // Carousel Controller Logic
        (function () {
            const track = document.getElementById('carousel-track');
            const prevBtn = document.getElementById('carousel-prev');
            const nextBtn = document.getElementById('carousel-next');
            const indicators = document.getElementById('carousel-indicators');
            const slides = track ? Array.from(track.children) : [];

            if (!track || slides.length === 0) return;

            let currentIndex = 0;
            let slideInterval;
            const intervalTime = 6000; // 6s per slide

            function updateCarousel(index) {
                // Infinite Looping bounds check
                if (index < 0) index = slides.length - 1;
                if (index >= slides.length) index = 0;
                
                currentIndex = index;
                track.style.transform = `translateX(-${currentIndex * 100}%)`;
                
                // Toggle active slide class for transition zoom effect
                slides.forEach((slide, i) => {
                    slide.classList.toggle('is-active-slide', i === currentIndex);
                });

                if (indicators) {
                    Array.from(indicators.children).forEach((indicator, i) => {
                        indicator.classList.toggle('is-active', i === currentIndex);
                    });
                }
            }

            function nextSlide() {
                updateCarousel(currentIndex + 1);
            }

            function prevSlide() {
                updateCarousel(currentIndex - 1);
            }

            nextBtn?.addEventListener('click', () => {
                nextSlide();
                resetInterval();
            });

            prevBtn?.addEventListener('click', () => {
                prevSlide();
                resetInterval();
            });

            if (indicators) {
                Array.from(indicators.children).forEach((indicator, i) => {
                    indicator.addEventListener('click', () => {
                        updateCarousel(i);
                        resetInterval();
                    });
                });
            }

            // Keyboard navigation support
            document.addEventListener('keydown', (e) => {
                // Focus bounds check: only trigger if user is not typing in search
                const active = document.activeElement;
                if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) {
                    return;
                }
                if (e.key === 'ArrowLeft') {
                    prevSlide();
                    resetInterval();
                } else if (e.key === 'ArrowRight') {
                    nextSlide();
                    resetInterval();
                }
            });

            // Touch Swipe / drag support for mobile and tablets
            let touchStartX = 0;
            let touchEndX = 0;

            const carouselContainer = document.getElementById('home-carousel');

            carouselContainer?.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            carouselContainer?.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                handleSwipeGesture();
            }, { passive: true });

            function handleSwipeGesture() {
                const swipeThreshold = 50; // pixels
                const diff = touchEndX - touchStartX;
                if (Math.abs(diff) > swipeThreshold) {
                    if (diff > 0) {
                        prevSlide(); // Swipe Right -> Prev Slide
                    } else {
                        nextSlide(); // Swipe Left -> Next Slide
                    }
                    resetInterval();
                }
            }

            function startInterval() {
                slideInterval = setInterval(nextSlide, intervalTime);
            }

            function resetInterval() {
                clearInterval(slideInterval);
                startInterval();
            }

            carouselContainer?.addEventListener('mouseenter', () => clearInterval(slideInterval));
            carouselContainer?.addEventListener('mouseleave', startInterval);

            startInterval();
        })();

        // Genre chips
        document.querySelectorAll('.genre-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                const genre = chip.dataset.genre;
                document.querySelectorAll('.genre-chip').forEach(c => c.classList.remove('is-active'));
                chip.classList.add('is-active');
                if (genre) window.location.href = '/Search?q=' + encodeURIComponent(genre);
            });
        });
    </script>
}

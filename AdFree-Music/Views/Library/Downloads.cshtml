@{
    ViewData["Title"] = "Downloads";
}

@section Styles {
    <style>
        .library-container {
            padding: 24px 0;
            animation: fadeIn 0.4s ease;
        }

        .library-title {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 8px;
        }

        .library-subtitle {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 32px;
        }
    </style>
}

<div class="library-container">
    <h1 class="library-title">Downloads</h1>
    <p class="library-subtitle">Songs downloaded to this browser for offline listening.</p>

    <!-- Downloads List -->
    <div id="downloads-list-container">
        <!-- JS populated downloaded songs -->
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Highlight Downloads sidebar link
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('is-active'));
            document.getElementById('nav-downloads')?.classList.add('is-active');

            renderDownloads();

            function renderDownloads() {
                const container = document.getElementById('downloads-list-container');
                if (!container) return;

                // Load metadata from localStorage
                let downloads = [];
                try {
                    downloads = JSON.parse(localStorage.getItem('umusic_downloaded_metadata') || '[]');
                } catch(e) {
                    downloads = [];
                }

                if (downloads.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                            </svg>
                            <p class="empty-state__title">No offline songs</p>
                            <p class="empty-state__sub">Click the option menu (⋮) next to any song and choose "Download" to save songs offline.</p>
                        </div>`;
                    return;
                }

                const headerHtml = `
                    <div class="song-list-header">
                        <span class="song-list-header__num"><span class="col-label">#</span></span>
                        <span class="song-list-header__art"></span>
                        <span class="song-list-header__info"><span class="col-label">Title</span></span>
                        <span class="song-list-header__album"><span class="col-label">Album</span></span>
                        <span class="song-list-header__dur">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.5">
                                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                            </svg>
                        </span>
                    </div>`;

                const itemsHtml = downloads.map((song, i) => {
                    const art = song.image || '/images/default_art.png';
                    const name = song.name || 'Unknown';
                    const artist = song.artist || 'Unknown Artist';
                    const album = song.album || '';
                    const dur = song.durationFormatted || '--:--';

                    return `
                        <div class="song-list-item" data-song-id="${song.id}" tabindex="0" role="button">
                            <span class="song-list-item__num">${i + 1}</span>
                            <div class="song-list-item__art">
                                <img src="${art}" alt="${name}" onerror="this.src=artFallback()">
                                <div class="song-list-item__art-overlay">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><polygon points="5,3 19,12 5,21"/></svg>
                                </div>
                            </div>
                            <div class="song-list-item__info">
                                <div class="song-list-item__name">${name}</div>
                                <div class="song-list-item__artist">${artist}</div>
                            </div>
                            <div class="song-list-item__album">${album}</div>
                            <div class="song-list-item__duration" style="display: flex; align-items: center; gap: 12px;">
                                <span>${dur}</span>
                                <button class="btn-delete-download" data-song-id="${song.id}" title="Delete offline download" style="color: var(--accent); padding: 4px;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </button>
                            </div>
                        </div>`;
                }).join('');

                container.innerHTML = `<div class="song-list">${headerHtml}${itemsHtml}</div>`;

                // Bind Play Event
                container.querySelectorAll('.song-list-item').forEach((el) => {
                    const songId = el.dataset.songId;
                    const song = downloads.find(s => s.id === songId);

                    el.addEventListener('click', (e) => {
                        // Prevent playing if delete icon clicked
                        if (e.target.closest('.btn-delete-download')) return;

                        const playList = downloads.map(s => ({
                            id: s.id,
                            name: s.name,
                            artist: s.artist,
                            album: s.album,
                            image: s.image,
                            streamUrl: s.streamUrl,
                            duration: s.duration,
                            durationFormatted: s.durationFormatted
                        }));
                        const idx = playList.findIndex(s => s.id === songId);
                        
                        window.playTrack?.(playList[idx], playList, idx);
                    });
                });

                // Bind Delete Event
                container.querySelectorAll('.btn-delete-download').forEach(btn => {
                    btn.addEventListener('click', async (e) => {
                        e.stopPropagation();
                        const songId = btn.dataset.songId;

                        if (confirm('Are you sure you want to delete this downloaded song?')) {
                            // Delete from Cache storage
                            if ('caches' in window) {
                                const cache = await caches.open('umusic-downloads');
                                await cache.delete(`/api/stream/${songId}`);
                            }

                            // Update metadata
                            const updated = downloads.filter(s => s.id !== songId);
                            localStorage.setItem('umusic_downloaded_metadata', JSON.stringify(updated));

                            // Rerender list
                            renderDownloads();
                        }
                    });
                });
            }
        });
    </script>
}
